        "/api/internal/search/food/llm-candidates/": {
            "get": {
                "tags": [
                    "food_tracker internal"
                ],
                "summary": "Get Food Internal Search Llm Candidates View",
                "description": "Вернуть стабильный hydrated список food candidates для FPS/LLM flow.\n\nEndpoint предназначен не для дебага ES, а как внутренний контракт между\nсервисами. Поэтому наружу отдается уже нормализованный JSON с полями,\nна которые может опираться FPS без знания внутренней структуры ES hit.",
                "operationId": "get_food_internal_search_llm_candidates_view_api_internal_search_food_llm_candidates__get",
                "security": [
                    {
                        "JWTAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "query",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Query"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1,
                            "title": "Page"
                        }
                    },
                    {
                        "name": "page_size",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 15,
                            "minimum": 1,
                            "default": 5,
                            "title": "Page Size"
                        }
                    },
                    {
                        "name": "fusion_search",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "default": false,
                            "title": "Fusion Search"
                        }
                    },
                    {
                        "name": "fusion_page_size",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 15,
                            "minimum": 1,
                            "default": 5,
                            "title": "Fusion Page Size"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FoodLLMCandidatePaginatedResponseSchema"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
